DATABASE_URL="postgresql://vihe:vihe@localhost:5432/vihe_app?schema=public"
TEST_DATABASE_URL="postgresql://vihe:vihe@localhost:5432/vihe_app_test?schema=public"

AUTH_URL="http://localhost:3000"

AUTH_SECRET="generate-with-npx-auth-secret"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-immediately"

# S3-compatible storage. Local MinIO (docker compose) uses path-style + custom endpoint.
# Production AWS S3: drop S3_ENDPOINT and S3_FORCE_PATH_STYLE, set region/bucket/keys.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="vihe-resources"
S3_ACCESS_KEY="vihe"
S3_SECRET_KEY="vihe-minio-secret"
S3_FORCE_PATH_STYLE="true"

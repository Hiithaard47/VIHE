generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  passwordHash  String?
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  roles                UserRole[]
  taughtSubjects       SubjectTeacher[]
  createdSessions      ClassSession[]         @relation("SessionCreatedBy")
  markedRecords        AttendanceRecord[]     @relation("AttendanceMarkedBy")
  reviewedApplications StudentApplication[]   @relation("ApplicationReviewedBy")
  uploadedResources    SessionResource[]      @relation("SessionResourceUploadedBy")
  createdAssignments   Assignment[]           @relation("AssignmentCreatedBy")
  gradedSubmissions    AssignmentSubmission[] @relation("AssignmentGradedBy")
  createdHomeworks     SessionHomework[]      @relation("SessionHomeworkCreatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Roles & permissions (flexible RBAC) ---

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "courses.manage"
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Admin", "Teacher"
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// --- Academic domain ---

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Attendance policy. Late/Excused apply to every category on the course.
  // Per-category min % lives on SessionCategory.
  defaultStatus           AttendanceStatus @default(PRESENT)
  lateCountsAsAttended    Boolean          @default(true)
  excusedCountsAsAttended Boolean          @default(true)
  lockAfterDays           Int?             // null = never locks

  // Portal login length for first enrollment. Null = infer from course code
  // (BSA/BPV 6 months, BS 1 year, BV/BVA 4 years, otherwise none).
  loginMonths Int?

  subjects     CourseSubject[]
  enrollments  CourseEnrollment[]
  applications StudentApplication[]

  @@map("courses")
}

model CourseSubject {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  isActive  Boolean   @default(true)
  termStart DateTime?
  weekCount Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teachers    SubjectTeacher[]
  sessions    ClassSession[]
  assignments Assignment[]

  @@unique([courseId, name])
  @@map("course_subjects")
}

model SubjectTeacher {
  subjectId String
  teacherId String

  subject CourseSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
  @@index([teacherId])
  @@map("subject_teachers")
}

model Student {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?
  rollNumber String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  passwordHash String?

  // Null = no expiry. First enrollment may fill this from the course.
  loginExpiresAt DateTime?

  enrollments CourseEnrollment[]
  attendance  AttendanceRecord[]
  submissions AssignmentSubmission[]
  homeworkSubmissions SessionHomeworkSubmission[]

  @@map("students")
}

model CourseEnrollment {
  courseId  String
  studentId String
  createdAt DateTime @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model SessionCategory {
  id                   String   @id @default(cuid())
  name                 String   @unique
  minAttendancePercent Int?
  isActive             Boolean  @default(true)
  isSystem             Boolean  @default(false)
  allowsResources      Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sessions ClassSession[]

  @@map("session_categories")
}

model ClassSession {
  id          String   @id @default(cuid())
  subjectId   String
  categoryId  String
  date        DateTime
  name        String
  createdById String
  createdAt   DateTime @default(now())

  startMinute Int?
  endMinute   Int?

  subject   CourseSubject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  category  SessionCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User               @relation("SessionCreatedBy", fields: [createdById], references: [id])
  records   AttendanceRecord[]
  resources SessionResource[]
  homework  SessionHomework?

  @@index([subjectId, date, startMinute])
  @@map("class_sessions")
}

model SessionHomework {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  title        String
  instructions String?
  createdById  String
  createdAt    DateTime @default(now())

  session     ClassSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy   User                         @relation("SessionHomeworkCreatedBy", fields: [createdById], references: [id])
  submissions SessionHomeworkSubmission[]

  @@map("session_homeworks")
}

model SessionHomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  studentId   String
  submittedAt DateTime @default(now())

  homework SessionHomework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student                         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files    SessionHomeworkSubmissionFile[]

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@map("session_homework_submissions")
}

model SessionHomeworkSubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  submission SessionHomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("session_homework_submission_files")
}

model SessionResource {
  id           String   @id @default(cuid())
  sessionId    String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String
  createdAt    DateTime @default(now())

  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("SessionResourceUploadedBy", fields: [uploadedById], references: [id])

  @@index([sessionId])
  @@map("session_resources")
}

model Assignment {
  id           String    @id @default(cuid())
  subjectId    String
  title        String
  instructions String?
  dueDate      DateTime?
  maxMarks     Int
  createdById  String
  createdAt    DateTime  @default(now())

  subject     CourseSubject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  files       AssignmentFile[]
  submissions AssignmentSubmission[]

  @@index([subjectId])
  @@map("assignments")
}

model AssignmentFile {
  id           String   @id @default(cuid())
  assignmentId String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_files")
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  attemptNumber Int       @default(1)
  submittedAt   DateTime  @default(now())
  marks         Int?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?

  assignment Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?                      @relation("AssignmentGradedBy", fields: [gradedById], references: [id])
  files      AssignmentSubmissionFile[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AssignmentSubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assignment_submission_files")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  markedById String
  markedAt   DateTime         @default(now())

  session  ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

// --- Public prospective-student intake ---

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PreferredMode {
  ONLINE
  HYBRID
  ON_SITE
}

enum PreferredLanguage {
  ENGLISH
  HINDI
}

model StudentApplication {
  id                String             @id @default(cuid())
  name              String
  email             String
  phone             String?
  message           String?
  desiredCourseId   String?
  preferredMode     PreferredMode?
  preferredLanguage PreferredLanguage?
  dateOfBirth       DateTime?
  country           String?
  city              String?
  priorExperience   String?
  status            ApplicationStatus  @default(PENDING)
  createdAt         DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedById      String?

  desiredCourse Course? @relation(fields: [desiredCourseId], references: [id])
  reviewedBy    User?   @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("student_applications")
}
